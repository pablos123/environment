# Work-home — work laptop, lid OPEN, LG FULL HD over HDMI, monitor primary
# and left of the laptop panel. Cannot be fabricated: autorandr matches by
# EDID, so it must be saved live with the monitor plugged in.
#
#   xrandr --output HDMI-1 --primary --auto --left-of eDP-1 --output eDP-1 --auto
#   autorandr --save Work-home
#   cp -r ~/.config/autorandr/Work-home ~/environment/dotfiles/config/.config/autorandr/
#   git -C ~/environment add -A && git -C ~/environment commit -m genc
#
# If the LG lands on another port, swap HDMI-1 for the name `xrandr` reports.
# Delete this file once the real 'config' and 'setup' are in place.
