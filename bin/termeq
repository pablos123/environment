#!/usr/bin/python3
"""termeq - tiny terminal equalizer for PipeWire (filter-chain biquads).

Creates an "Equalizer Sink" output device and edits its gains live.
On first run it writes the PipeWire config and restarts PipeWire.
Saved gains live in ~/.config (user state, not part of the dotfiles).
"""
import curses, json, os, re, subprocess, sys, time

CONF = os.path.expanduser("~/.config/pipewire/pipewire.conf.d/termeq.conf")
NODE = "effect_input.termeq"
# (label, type, freq, Q)
BANDS = [
    ("60Hz",  "bq_lowshelf",  60,    0.7),
    ("150Hz", "bq_peaking",   150,   1.0),
    ("400Hz", "bq_peaking",   400,   1.0),
    ("1kHz",  "bq_peaking",   1000,  1.0),
    ("2.5kHz","bq_peaking",   2500,  1.0),
    ("6kHz",  "bq_peaking",   6000,  1.0),
    ("12kHz", "bq_highshelf", 12000, 0.7),
]
MAXDB, STEP = 12.0, 0.5


def render_conf(gains):
    nodes = "\n".join(
        f'            {{ type = builtin name = eq_band_{i+1} label = {t}\n'
        f'              control = {{ "Freq" = {f:.1f} "Q" = {q} "Gain" = {g:.1f} }} }}'
        for i, ((_, t, f, q), g) in enumerate(zip(BANDS, gains)))
    links = "\n".join(
        f'            {{ output = "eq_band_{i}:Out" input = "eq_band_{i+1}:In" }}'
        for i in range(1, len(BANDS)))
    return f"""# Generated by termeq - edit gains with `termeq`
context.modules = [
  {{ name = libpipewire-module-filter-chain
    args = {{
      node.description = "Equalizer Sink"
      media.name       = "Equalizer Sink"
      filter.graph = {{
        nodes = [
{nodes}
        ]
        links = [
{links}
        ]
      }}
      audio.channels = 2
      audio.position = [ FL FR ]
      capture.props  = {{ node.name = "{NODE}" media.class = Audio/Sink }}
      playback.props = {{ node.name = "effect_output.termeq" node.passive = true }}
    }}
  }}
]
"""


def load_gains():
    try:
        txt = open(CONF).read()
        g = [float(x) for x in re.findall(r'"Gain" = (-?[\d.]+)', txt)]
        if len(g) == len(BANDS):
            return g
    except OSError:
        pass
    return [0.0] * len(BANDS)


def save(gains):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as fh:
        fh.write(render_conf(gains))


def node_id():
    dump = json.loads(subprocess.run(["pw-dump"], capture_output=True, text=True).stdout)
    for o in dump:
        if o.get("type") == "PipeWire:Interface:Node" and \
           o.get("info", {}).get("props", {}).get("node.name") == NODE:
            return o["id"]
    return None


def apply(nid, idx, gain):
    subprocess.run(["pw-cli", "set-param", str(nid), "Props",
                    f'{{ params = [ "eq_band_{idx+1}:Gain" {gain:.1f} ] }}'],
                   capture_output=True)


def tui(scr, nid, gains):
    curses.curs_set(0)
    curses.use_default_colors()
    sel, msg, width = 0, "", 24
    while True:
        scr.erase()
        scr.addstr(0, 1, "Equalizer Sink", curses.A_BOLD)
        for i, (label, *_ ) in enumerate(BANDS):
            g = gains[i]
            pos = int(round((g + MAXDB) / (2 * MAXDB) * width))
            bar = "".join("|" if c == width // 2 else ("█" if (c < pos if g >= 0 else c >= pos) and
                          (c >= width // 2 if g >= 0 else c < width // 2) else "·")
                          for c in range(width + 1))
            attr = curses.A_REVERSE if i == sel else 0
            scr.addstr(2 + i, 1, f"{label:>7} ", attr)
            scr.addstr(2 + i, 10, f"{bar} {g:+5.1f} dB")
        y = 3 + len(BANDS)
        scr.addstr(y, 1, "↑/↓ band  ←/→ gain  0 reset band  r reset all  s save  q quit", curses.A_DIM)
        scr.addstr(y + 1, 1, msg)
        k = scr.getch()
        msg = ""
        if k == ord("q"):
            return
        elif k in (curses.KEY_UP, ord("k")):
            sel = (sel - 1) % len(BANDS)
        elif k in (curses.KEY_DOWN, ord("j")):
            sel = (sel + 1) % len(BANDS)
        elif k in (curses.KEY_RIGHT, ord("l"), curses.KEY_LEFT, ord("h"), ord("0")):
            d = STEP if k in (curses.KEY_RIGHT, ord("l")) else -STEP
            gains[sel] = 0.0 if k == ord("0") else max(-MAXDB, min(MAXDB, gains[sel] + d))
            apply(nid, sel, gains[sel])
        elif k == ord("r"):
            for i in range(len(gains)):
                gains[i] = 0.0
                apply(nid, i, 0.0)
        elif k == ord("s"):
            save(gains)
            msg = "saved (persists across restarts)"


def main():
    nid = node_id()
    if nid is None:
        print("Equalizer Sink not found - writing config and restarting PipeWire...")
        save(load_gains())
        subprocess.run(["systemctl", "--user", "restart", "pipewire", "pipewire-pulse", "wireplumber"])
        for _ in range(20):
            time.sleep(0.25)
            nid = node_id()
            if nid is not None:
                break
        else:
            sys.exit(f"Equalizer Sink still missing - check {CONF}")
    gains = load_gains()
    for i, g in enumerate(gains):  # sync running filter with saved state
        apply(nid, i, g)
    curses.wrapper(tui, nid, gains)


if __name__ == "__main__":
    main()
